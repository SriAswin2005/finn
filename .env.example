# Run npm run configure:ai, or copy this to .env. Use a billing-DISABLED project.
GEMINI_API_KEY=
FINN_AI_FREE_TIER_CONFIRMED=false
# Confirm availability/free access in YOUR AI Studio project before enabling.
# Inventory accepts up to 40 IDs. Embedding/audio/live and unverified IDs are
# saved but excluded from research. Optional text candidates:
# gemini-3.8-flash,gemini-3.6-flash,gemma-4-26b-a4b-it,gemma-4-31b-it
FINN_GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
FINN_AI_TOTAL_DAILY_LIMIT=20
FINN_AI_MODEL_DAILY_LIMIT=20
FINN_AI_MODEL_HOURLY_LIMIT=5
# Optional Python override; otherwise .venv is detected automatically.
# PYTHON_BIN=
# Hosted demo: generate a random 32+ character token in the host dashboard.
# Open https://HOST/?key=TOKEN once; share that private link only with reviewers.
FINN_ACCESS_TOKEN=
FINN_REQUIRE_ACCESS_TOKEN=false
# Railway defaults to cache-only even when a key exists. Do not upload a key.
FINN_AI_CACHE_ONLY=false

# Vercel + Neon (server-only; no Gemini key on host)
DATABASE_URL=
FINN_PARSER_SECRET=

# Push is disabled until durable quota is reconciled and hosted approval is given.
FINN_PUSH_ENABLED=false
FINN_PUSH_HOSTED_APPROVED=false
FINN_PUSH_WORKER_SECRET=
FINN_PUSH_COLLECTION_MINUTES=15
FINN_PUSH_ANALYSIS_MINUTES=15
# Optional JSON override of src/config/model-policy.json (server only).
# FINN_MODEL_POLICY_JSON=
