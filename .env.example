# Copy to .env locally. Use a Gemini project with billing DISABLED.
GEMINI_API_KEY=
FINN_AI_FREE_TIER_CONFIRMED=false
# Confirm availability/free access in YOUR AI Studio project before enabling.
FINN_GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
FINN_AI_TOTAL_DAILY_LIMIT=20
FINN_AI_MODEL_DAILY_LIMIT=20
FINN_AI_MODEL_HOURLY_LIMIT=5
# Optional Python override; otherwise .venv is detected automatically.
# PYTHON_BIN=
